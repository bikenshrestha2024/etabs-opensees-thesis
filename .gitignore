# Potentially confidential generated analysis and audit packages
Review_ZIPs/
*_Review_UPLOAD.zip
*security_history_private*
security_history_private.json

# Local, private ETABS XLSX evidence staging; never publish source workbook paths or hashes.
**/10_PRIVATE_ETABS_WORKBOOKS/

# Local source/path audits may contain confidential source names and machine paths.
# Keep them out of public commits; CI can publish sanitized workflow artifacts.
/audit/

# Project-specific mesh connectivity/viewer exports contain geometry, sections,
# node incidences and potentially source identifiers. Keep private to export case.
REVIEW_MAIN/00_MODEL/20261116_MESH04_AND_ETABS23_VERIFICATION/Frame_Mesh_Interface_Audit.json
REVIEW_MAIN/00_MODEL/20261116_MESH04_AND_ETABS23_VERIFICATION/MESH_04_Node_Roles.csv
REVIEW_MAIN/00_MODEL/20261116_MESH04_AND_ETABS23_VERIFICATION/MESH_04_Floor_Mesh_3D.html
REVIEW_MAIN/00_MODEL/20261116_MESH04_AND_ETABS23_VERIFICATION/MESH_04_Floor_and_Beam_3D.html

# Independent Studio native benchmark results are local private evidence.
/VERIFICATION_RUNS/
/VERIFICATION_RUNS*/

# Pinned semantic discovery outputs: generated on CI/local machine, never auto-published as model evidence.
/AUDIT_RUNS/

# Model-derived viewer diagnostics contain source ETABS node coordinates,
# shell/frame topology, geometry, section properties and identifiers.
# Keep local to private export cases; tracked historical snapshots need
# a separate reviewed history remediation, not a force push.
/Viewer_Preview_V*/
/New_Export_Viewer_Diagnostic/
